{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "headers": [
    {
      "source": "/client-metadata.json",
      "headers": [
        { "key": "content-type", "value": "application/json" },
        { "key": "access-control-allow-origin", "value": "*" },
        { "key": "cache-control", "value": "public, max-age=300" }
      ]
    }
  ]
}
